# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Vercel & Client-Side Hosting (Vite / React)
# -----------------------------------------------------------------------------
# Public App URL for production deployments on Vercel
VITE_APP_URL="https://your-project.vercel.app"

# -----------------------------------------------------------------------------
# Supabase Client Credentials (Safe for Client-Side in Vite)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL & Project API Keys
# -----------------------------------------------------------------------------
# Your Supabase project REST API endpoint URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Public anon/publishable key for browser authentication and public table queries
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# -----------------------------------------------------------------------------
# Supabase Server-Side Secrets (DO NOT prefix with VITE_)
# Keep secret on serverless functions/backends; never expose in browser client bundles
# -----------------------------------------------------------------------------
# Privileged service role key for admin operations, bypasses Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase JWT Secret for signing and verifying tokens
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# -----------------------------------------------------------------------------
# PostgreSQL Database Connection Strings (Vercel Postgres / Supabase Database)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
# -----------------------------------------------------------------------------
# Primary PostgreSQL URI (Pooled connection via Transaction pooler on port 6543)
# Suitable for serverless and Edge functions on Vercel
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Alias frequently used by Vercel integration
POSTGRES_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Non-pooling connection string (Session pooler or port 5432)
# Required for running migrations or DDL schema operations
POSTGRES_URL_NON_POOLING="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Individual connection parameters if needed by custom drivers
PGHOST="db.[YOUR-PROJECT-ID].supabase.co"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres"
PGPASSWORD="[YOUR-PASSWORD]"

